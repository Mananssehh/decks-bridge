# Copy to .env.signing and fill in. NEVER commit .env.signing.

# Developer ID Application certificate identity (exact name from Keychain Access)
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
APPLE_TEAM_ID="TEAMID"

# Option A — Apple ID + app-specific password (notarytool)
APPLE_ID="you@example.com"
APPLE_APP_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# Option B — App Store Connect API key (preferred for CI)
# APPLE_API_KEY_ID="..."
# APPLE_API_ISSUER="..."
# APPLE_API_KEY_PATH="/path/to/AuthKey_XXXX.p8"

# Tauri updater signing (minisign) — both macOS and Windows updater archives
# TAURI_SIGNING_PRIVATE_KEY="..."
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""

# Windows Authenticode (optional — reduces SmartScreen warnings)
# WINDOWS_SIGNING_CERT="/path/to/codesign.pfx"
# WINDOWS_SIGNING_CERT_PASSWORD=""
# CI: base64-encode the PFX as WINDOWS_SIGNING_CERT secret
