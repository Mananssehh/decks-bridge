# Development-only. Vite loads .env.development for `vite` (dev) but NEVER for
# `vite build` (production), so mock data is automatically dev-only. The
# check-no-mock.mjs build guard additionally blocks any prod build with mock on.
# Set to `true` to develop the viewer against MockBridgeProvider offline.
# Left `false` so `tauri dev` uses the real LiveBridgeProvider + the paired
# event's token (verified real-data flow). Production never uses mock regardless.
VITE_MOCK_DATA=false
