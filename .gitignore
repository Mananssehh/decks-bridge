# ── Secrets ───────────────────────────────────────────────────────────────────
# Never commit signing credentials. The updater private key lives in a password
# manager / CI secret, never here. See scripts/load-signing-env.sh.
.env.signing
.env.local
.env.*.local
*.p12
*.pem
*.pfx
AuthKey*.p8

# ── Dependencies & build output ───────────────────────────────────────────────
node_modules/
dist/
src-tauri/target/
src-tauri/gen/schemas/

# ── Release artifacts (regenerated by scripts/build-release.sh) ───────────────
# The tester-facing folders keep their README/TEST_INSTALL docs in git; only the
# built binaries that package-artifacts.sh drops into them are ignored.
release/
*.dmg
*.app.zip
*.app.tar.gz
*.app.tar.gz.sig
*.nsis.zip
decks bridge 091/*.zip
decks bridge 091/*.app/
decks bridge Mac/*.zip
decks bridge Mac/*.app/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
release-build.log

# ── OS / editor cruft ─────────────────────────────────────────────────────────
.DS_Store
._*
.vscode/
.idea/
*.swp

# ── Machine-local tooling config ──────────────────────────────────────────────
# settings.local.json is per-machine Claude Code state (absolute home paths,
# local permission grants). It is not project config and should not be shared.
.claude/settings.local.json
